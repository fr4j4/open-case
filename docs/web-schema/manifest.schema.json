{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "schema_version: raise it (and save the new fingerprint) when this schema changes"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "case": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "total_size": {
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "version",
    "case",
    "language",
    "files",
    "total_size"
  ],
  "additionalProperties": false
}
